// Portable Prisma contract for the GridTrade PostgreSQL domain.
// The runtime workspace currently uses Drizzle for its existing generated DB
// package; this schema keeps the same durable model available for future
// Prisma-based services and migration tooling.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PROSUMER
  CONSUMER
  UTILITY
  REGULATOR
  ADMIN
}

enum SolarSystemStatus {
  online
  standby
  offline
}

enum ListingStatus {
  active
  matched
  closed
  restricted
}

enum TradeStatus {
  proposed
  confirmed
  settled
  cancelled
}

enum TransactionStatus {
  pending
  confirmed
  failed
}

enum GridDecision {
  APPROVED
  ADJUSTED
  RESTRICTED
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  clerkId      String?       @unique
  email        String        @unique
  displayName  String
  role         UserRole      @default(PROSUMER)
  solarSystems SolarSystem[]
  listings     Listing[]
  trades       Trade[]       @relation("BuyerTrades")
  auditLogs    AuditLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([role])
  @@map("users")
}

model SolarSystem {
  id              String        @id @default(uuid()) @db.Uuid
  ownerId         String        @db.Uuid
  owner           User          @relation(fields: [ownerId], references: [id])
  name            String
  capacityKw      Decimal       @db.Decimal(12, 3)
  location        String
  status          SolarSystemStatus @default(online)
  energyData      EnergyData[]
  listings        Listing[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([ownerId])
  @@map("solar_systems")
}

model EnergyData {
  id                    String      @id @default(uuid()) @db.Uuid
  solarSystemId         String      @db.Uuid
  solarSystem           SolarSystem @relation(fields: [solarSystemId], references: [id])
  observedAt             DateTime
  generationKwh         Decimal     @db.Decimal(14, 4)
  consumptionKwh        Decimal     @db.Decimal(14, 4)
  marketableSurplusKwh  Decimal     @db.Decimal(14, 4)
  source                String      @default("prototype")

  @@index([solarSystemId, observedAt])
  @@map("energy_data")
}

model Listing {
  id             String        @id @default(uuid()) @db.Uuid
  sellerId       String        @db.Uuid
  seller         User          @relation(fields: [sellerId], references: [id])
  solarSystemId  String        @db.Uuid
  solarSystem    SolarSystem   @relation(fields: [solarSystemId], references: [id])
  quantityKwh    Decimal       @db.Decimal(14, 4)
  priceInrPerKwh Decimal       @db.Decimal(12, 4)
  availableFrom  DateTime
  availableUntil DateTime
  status         ListingStatus @default(active)
  gridDecision   GridDecision  @default(APPROVED)
  trades         Trade[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([sellerId])
  @@map("listings")
}

model Trade {
  id                    String        @id @default(uuid()) @db.Uuid
  listingId             String        @db.Uuid
  listing               Listing       @relation(fields: [listingId], references: [id])
  buyerId               String        @db.Uuid
  buyer                 User          @relation("BuyerTrades", fields: [buyerId], references: [id])
  quantityKwh           Decimal       @db.Decimal(14, 4)
  agreedPriceInrPerKwh  Decimal       @db.Decimal(12, 4)
  status                TradeStatus   @default(proposed)
  transactions          Transaction[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([listingId])
  @@index([buyerId])
  @@map("trades")
}

model Transaction {
  id          String            @id @default(uuid()) @db.Uuid
  tradeId     String            @db.Uuid
  trade       Trade             @relation(fields: [tradeId], references: [id])
  amountInr   Decimal           @db.Decimal(14, 4)
  status      TransactionStatus @default(pending)
  payment     Payment?
  hashRecord  HashRecord?
  settledAt   DateTime?
  createdAt   DateTime          @default(now())

  @@index([tradeId])
  @@map("transactions")
}

model Payment {
  id                String      @id @default(uuid()) @db.Uuid
  transactionId     String      @unique @db.Uuid
  transaction       Transaction @relation(fields: [transactionId], references: [id])
  provider          String      @default("prototype")
  providerReference String?
  amountInr         Decimal     @db.Decimal(14, 4)
  status            String      @default("pending")
  createdAt         DateTime    @default(now())

  @@map("payments")
}

model HashRecord {
  id            String      @id @default(uuid()) @db.Uuid
  transactionId String      @unique @db.Uuid
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  algorithm     String      @default("SHA-256")
  hash          String      @unique
  createdAt     DateTime    @default(now())

  @@map("hash_records")
}

model GridData {
  id                    String       @id @default(uuid()) @db.Uuid
  region                String
  observedAt            DateTime
  congestionPercent     Decimal      @db.Decimal(6, 3)
  renewableSharePercent Decimal      @db.Decimal(6, 3)
  frequencyHz           Decimal      @db.Decimal(8, 4)
  decision              GridDecision
  predictions           AiPrediction[]

  @@index([region, observedAt])
  @@map("grid_data")
}

model AiPrediction {
  id             String    @id @default(uuid()) @db.Uuid
  gridDataId     String?   @db.Uuid
  gridData       GridData? @relation(fields: [gridDataId], references: [id])
  predictionType String
  horizon        String
  payload        Json
  confidence     Decimal?  @db.Decimal(6, 4)
  createdAt      DateTime  @default(now())

  @@index([predictionType])
  @@map("ai_predictions")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?  @db.Uuid
  requestId  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}